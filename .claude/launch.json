{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "elysium",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "arcsphere",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "elysium-verify",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_DIST_DIR=.next-verify", "npm", "run", "dev"],
      "port": 3200,
      "autoPort": true
    }
  ]
}
