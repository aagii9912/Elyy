# ── Lead capture → Google Sheet (зориулалт: борлуулалтын баг) ──
# Тохируулгын алхам бүрийг docs/lead-integration.md файлаас үзнэ үү.

# Google Sheet-ийн ID — URL-ийн docs.google.com/spreadsheets/d/<ЭНЭ ХЭСЭГ>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Service account-ын и-мэйл (xxx@project-id.iam.gserviceaccount.com)
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account-ын private key — JSON дотроос "private_key" утгыг
# мөр шилжилтүүдийг нь \n болгож нэг мөрөнд хуулна
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Lead нэмэх sheet tab-ийн нэр (заавал биш, default: Leads)
GOOGLE_SHEETS_TAB=Leads
